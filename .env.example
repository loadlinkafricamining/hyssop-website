# Copy this file to .env.local and fill in real values.
# The site works without any of these — checkout falls back to a WhatsApp
# handoff until PayFast is configured, and the contact form just skips
# emailing until Resend is configured.

# --- Site URL (used to build PayFast return/cancel/notify URLs) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- PayFast (checkout) ---
# Get these from your PayFast merchant dashboard: Settings > Integration.
# Leave PAYFAST_SANDBOX=true until you're ready to accept real payments.
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
PAYFAST_SANDBOX="true"

# --- Resend (order notification + contact form emails) ---
RESEND_API_KEY=""
EMAIL_FROM="orders@hyssop.example.co.za"
